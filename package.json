{
  "name": "notification-audit-services",
  "version": "1.0.0",
  "description": "Multi-service notification and audit logging system",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
